import java.util.Random;
import java.util.Scanner;

public class NumberGuessingGame {
    private static final Scanner sc = new Scanner(System.in);
    private static final Random random = new Random();
    
    private static int totalRounds = 0;
    private static int totalWins = 0;

    public static void main(String[] args) {
        System.out.println("=== NUMBER GUESSING GAME ===");
        System.out.println("Guess the number! I'll give you Higher/Lower hints.");

        boolean playAgain = true;

        while (playAgain) {
            // --- Difficulty selection (Bonus) ---
            System.out.println("\nSelect Difficulty:");
            System.out.println("1. Easy   (1-50,  10 attempts)");
            System.out.println("2. Medium (1-100, 7 attempts)");
            System.out.println("3. Hard   (1-200, 5 attempts)");
            System.out.print("Enter choice (1-3) [default 2]: ");
            String diffInput = sc.nextLine().trim();
            
            int maxRange = 100;
            int maxAttempts = 7;
            
            switch (diffInput) {
                case "1" -> { maxRange = 50; maxAttempts = 10; System.out.println("Easy mode selected!"); }
                case "3" -> { maxRange = 200; maxAttempts = 5; System.out.println("Hard mode selected!"); }
                default -> { maxRange = 100; maxAttempts = 7; System.out.println("Medium mode selected!"); }
            }

            // --- Generate random number 1 to maxRange ---
            int numberToGuess = random.nextInt(maxRange) + 1;
            int attempts = 0;
            boolean guessedCorrectly = false;

            totalRounds++;
            System.out.printf("\n--- Round %d ---\n", totalRounds);
            System.out.printf("I have generated a number between 1 and %d. You have %d attempts.\n", maxRange, maxAttempts);

            // --- Main guessing loop ---
            while (attempts < maxAttempts) {
                System.out.printf("\n[Attempt %d/%d] Enter your guess: ", attempts + 1, maxAttempts);
                String input = sc.nextLine().trim();
                
                int guess;
                try {
                    guess = Integer.parseInt(input);
                } catch (NumberFormatException e) {
                    System.out.println("Invalid input! Please enter a number.");
                    continue; // don't count invalid as attempt
                }

                if (guess < 1 || guess > maxRange) {
                    System.out.printf("Out of range! Enter between 1 and %d\n", maxRange);
                    continue;
                }

                attempts++;

                // --- Check and display response ---
                if (guess == numberToGuess) {
                    System.out.println("Correct! You guessed it!");
                    System.out.printf("Round %d — guessed in %d attempts\n", totalRounds, attempts);
                    totalWins++;
                    guessedCorrectly = true;
                    break;
                } else if (guess < numberToGuess) {
                    System.out.println("Too Low!");
                } else {
                    System.out.println("Too High!");
                }
                
                // Show attempt counter visible
                System.out.printf("Attempts left: %d\n", maxAttempts - attempts);
            }

            // --- Loss condition ---
            if (!guessedCorrectly) {
                System.out.printf("\nYou Lost! The number was: %d\n", numberToGuess);
                System.out.printf("Round %d — failed in %d attempts\n", totalRounds, maxAttempts);
            }

            // --- Score tracking ---
            System.out.printf("\nScore: %d Wins / %d Rounds\n", totalWins, totalRounds);

            // --- Play Again option ---
            System.out.print("\nPlay Again? (yes/no): ");
            String again = sc.nextLine().trim().toLowerCase();
            playAgain = again.equals("yes") || again.equals("y");
        }

        System.out.println("\nThanks for playing! Final Score: " + totalWins + "/" + totalRounds);
        sc.close();
    }
}
